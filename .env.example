# Copy to .env and fill in.

# Local docker-compose default. If using Supabase, use its connection string instead.
DATABASE_URL="postgresql://journi:journi@localhost:5432/journi"

# Server-side only — used by src/lib/openai.ts. Never expose to the client.
OPENAI_API_KEY=""

# Optional — used by src/lib/embeddings.ts for the RAG corpus (RAG.md).
# Defaults to text-embedding-3-small (1536 dimensions, matches the vector(1536)
# column in prisma/schema.prisma). Only override if you also update that
# column's dimension count to match.
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Stand-in for auth. Every "created_by" / "reviewed_by" field reads from here
# until real auth exists — see README.
CURRENT_USER_NAME="Demo Owner"
